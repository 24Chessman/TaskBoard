# Port number for the Express API server
PORT=5000

# MongoDB Atlas connection URI string
MONGO_URI=

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=

# Expiration duration for JWT authentication tokens
JWT_EXPIRES_IN=7d

# Allowed frontend client origin for CORS (comma separated for several). Development: the Vite client.
# Production: optional, only needed when a client on ANOTHER origin calls the API; leave it unset when the server
# serves the built client itself (same origin)
CLIENT_ORIGIN=http://localhost:5173

# Optional GitHub personal access token to increase GitHub REST API rate limits
GITHUB_TOKEN=

# Display name of the admin account created by npm run seed:admin
ADMIN_NAME=

# Email of the admin account created (or promoted) by npm run seed:admin
ADMIN_EMAIL=

# Password of the new admin account (at least 6 characters); only used by npm run seed:admin
ADMIN_PASSWORD=
