# Port number for the Express API server
PORT=5000

# MongoDB Atlas connection URI string
MONGO_URI=

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=

# Expiration duration for JWT authentication tokens
JWT_EXPIRES_IN=7d

# Allowed frontend client origin for CORS in development
CLIENT_ORIGIN=http://localhost:5173

# Optional GitHub personal access token to increase GitHub REST API rate limits
GITHUB_TOKEN=
