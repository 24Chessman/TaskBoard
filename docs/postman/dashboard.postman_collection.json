{
  "info": {
    "name": "TaskBoard Dashboard",
    "description": "M4.4a project dashboard statistics (read only). Run the requests in order: Setup registers an owner, a member and an outsider, creates a project and three tasks (an open overdue task, a Done task with a past due date, an unassigned task due in 3 days), then the Dashboard folder checks the numbers and the access rules. The last request deletes the project.\n\n\"Today\" is the start of the day in UTC, so a task due today or yesterday near midnight can count differently in other time zones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenOwner",
      "value": ""
    },
    {
      "key": "tokenMember",
      "value": ""
    },
    {
      "key": "tokenOutsider",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "outsiderId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "pastDate",
      "value": ""
    },
    {
      "key": "soonDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register owner",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));",
                  "const day = 24 * 60 * 60 * 1000;",
                  "pm.collectionVariables.set('pastDate', new Date(Date.now() - 3 * day).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('soonDate', new Date(Date.now() + 3 * day).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tokenOwner', pm.response.json().data.token);",
                  "pm.collectionVariables.set('ownerId', pm.response.json().data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard Owner\",\n  \"email\": \"dashboard-owner-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tokenMember', pm.response.json().data.token);",
                  "pm.collectionVariables.set('memberId', pm.response.json().data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard Member\",\n  \"email\": \"dashboard-member-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register outsider",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tokenOutsider', pm.response.json().data.token);",
                  "pm.collectionVariables.set('outsiderId', pm.response.json().data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard Outsider\",\n  \"email\": \"dashboard-outsider-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Create project (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('projectId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard project {{runId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            }
          }
        },
        {
          "name": "Add the member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{memberId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "members"
              ]
            }
          }
        },
        {
          "name": "Task 1: open and overdue (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Overdue open task\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"assignee\": \"{{ownerId}}\",\n  \"dueDate\": \"{{pastDate}}\",\n  \"labels\": [\n    \"bug\",\n    \"api\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Task 2: Done with a past due date (assigned to the member)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Done late task\",\n  \"status\": \"done\",\n  \"priority\": \"low\",\n  \"assignee\": \"{{memberId}}\",\n  \"dueDate\": \"{{pastDate}}\",\n  \"labels\": [\n    \"bug\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Task 3: unassigned, due in 3 days",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unassigned soon task\",\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"{{soonDate}}\",\n  \"labels\": [\n    \"api\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard as owner - 200 and numbers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('total is 3', () => pm.expect(d.total).to.eql(3));",
                  "pm.test('byStatus has every status', () => pm.expect(d.byStatus).to.eql({ todo: 1, in_progress: 1, review: 0, done: 1 }));",
                  "pm.test('byPriority has every priority', () => pm.expect(d.byPriority).to.eql({ low: 1, medium: 1, high: 1 }));",
                  "pm.test('overdue ignores the Done task', () => pm.expect(d.overdue).to.eql(1));",
                  "pm.test('dueSoon counts the task due in 3 days', () => pm.expect(d.dueSoon).to.eql(1));",
                  "pm.test('unassigned counts open tasks without an assignee', () => pm.expect(d.unassigned).to.eql(1));",
                  "pm.test('perMember rows (total desc, then name)', () => pm.expect(d.perMember.map((m) => [m.name, m.total, m.done])).to.eql([['Dashboard Member', 1, 1], ['Dashboard Owner', 1, 0]]));",
                  "pm.test('perMember has userId and name only', () => d.perMember.forEach((m) => pm.expect(Object.keys(m).sort()).to.eql(['done', 'name', 'total', 'userId'])));",
                  "pm.test('topLabels: count desc, then label asc', () => pm.expect(d.topLabels).to.eql([{ label: 'api', count: 2 }, { label: 'bug', count: 2 }]));",
                  "pm.test('createdPerDay has 14 days ending today with 3 new tasks', () => { pm.expect(d.createdPerDay).to.have.length(14); pm.expect(d.createdPerDay[13].count).to.eql(3); pm.expect(d.createdPerDay[13].date).to.eql(new Date().toISOString().slice(0, 10)); });",
                  "pm.test('no email address in the response', () => pm.expect(pm.response.text()).to.not.include('@example.com'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Dashboard as member - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('same total', () => pm.expect(pm.response.json().data.total).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenMember}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Dashboard as outsider - 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOutsider}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Dashboard without a token - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Dashboard with an invalid project id - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/not-an-id/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "not-an-id",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Dashboard of an unknown project - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/0123456789abcdef01234567/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "0123456789abcdef01234567",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Query string is ignored - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('numbers still come from the URL project', () => pm.expect(pm.response.json().data.total).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard?projectId=000000000000000000000000&$ne=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ],
              "query": [
                {
                  "key": "projectId",
                  "value": "000000000000000000000000"
                },
                {
                  "key": "$ne",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "POST is not allowed - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete the project (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
