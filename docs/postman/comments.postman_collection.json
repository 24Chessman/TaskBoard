            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "Add comment - outsider (B)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenB}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Should not be saved\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "Add comment - empty text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('errors array names the text field', () => pm.expect(pm.response.json().errors[0].field).to.eql('text'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"   \"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "Add comment - text is not a string",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": 123\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "Add comment - invalid task id",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"hello\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/not-an-id/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "not-an-id", "comments"] }
          }
        },
        {
          "name": "Add comment - unknown task",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 404', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"hello\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/000000000000000000000001/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "000000000000000000000001", "comments"] }
          }
        },
        {
          "name": "Edit comment - invalid comment id",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"hello\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments/not-an-id", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments", "not-an-id"] }
          }
        },
        {
          "name": "Edit comment - unknown comment",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 404', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"hello\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments/000000000000000000000001", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments", "000000000000000000000001"] }
          }
        },
        {
          "name": "Edit comment - missing text (author)",
          "event": [
