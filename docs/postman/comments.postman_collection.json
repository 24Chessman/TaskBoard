{
  "info": {
    "name": "TaskBoard Comments",
    "description": "M4.2 comment endpoints. Run the folders in order: Setup registers user A (project owner) and user B (an outsider at first), creates a project and a task. Later B is added as a member to test the author rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "password", "value": "secret123" },
    { "key": "runId", "value": "" },
    { "key": "tokenA", "value": "" },
    { "key": "tokenB", "value": "" },
    { "key": "userAId", "value": "" },
    { "key": "userBId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "commentAId", "value": "" },
    { "key": "commentA2Id", "value": "" },
    { "key": "commentBId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register user A (project owner)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('runId', String(Date.now()));"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenA', body.data.token);",
                  "pm.collectionVariables.set('userAId', body.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Comments A\",\n  \"email\": \"comments-a-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register user B (starts as an outsider)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenB', body.data.token);",
                  "pm.collectionVariables.set('userBId', body.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Comments B\",\n  \"email\": \"comments-b-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Create project (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('projectId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Comments Project {{runId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Create task (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('taskId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Write the report\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks"] }
          }
        }
      ]
    },
    {
      "name": "Comments as the owner (A)",
      "item": [
        {
          "name": "Add comment (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const comment = pm.response.json().data;",
                  "pm.test('author is populated and text is trimmed', () => {",
                  "  pm.expect(comment.author._id).to.eql(pm.collectionVariables.get('userAId'));",
                  "  pm.expect(comment.author).to.have.property('email');",
                  "  pm.expect(comment.text).to.eql('First comment');",
                  "});",
                  "pm.collectionVariables.set('commentAId', comment._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"  First comment  \"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "Add a second comment (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentA2Id', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Second comment\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "List comments (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('oldest first, default paging', () => {",
                  "  pm.expect(body.total).to.eql(2);",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(50);",
                  "  pm.expect(body.data[0]._id).to.eql(pm.collectionVariables.get('commentAId'));",
                  "  pm.expect(body.data[1]._id).to.eql(pm.collectionVariables.get('commentA2Id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "List comments with page and limit (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('page 2 of limit 1 is the second comment', () => {",
                  "  pm.expect(body.page).to.eql(2);",
                  "  pm.expect(body.limit).to.eql(1);",
                  "  pm.expect(body.total).to.eql(2);",
                  "  pm.expect(body.data).to.have.lengthOf(1);",
                  "  pm.expect(body.data[0]._id).to.eql(pm.collectionVariables.get('commentA2Id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments?page=2&limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Edit own comment (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('text was replaced', () => pm.expect(pm.response.json().data.text).to.eql('First comment, edited'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"First comment, edited\"\n}" },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentAId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments", "{{commentAId}}"] }
          }
        }
      ]
    },
    {
      "name": "Failure cases",
      "item": [
        {
          "name": "List comments - no token",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{taskId}}", "comments"] }
          }
        },
        {
          "name": "List comments - outsider (B)",
          "event": [
            {
              "listen": "test",
