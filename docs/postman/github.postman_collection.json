    },
    {
      "name": "Task githubIssue rule",
      "item": [
        {
          "name": "Create a task with a valid githubIssue - 201, canonical url",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('taskId', d._id);",
                  "pm.test('url is stored in canonical form', () => pm.expect(d.githubIssue.url).to.eql('https://github.com/24Chessman/TaskBoard/pull/1'));",
                  "pm.test('title and state are kept', () => { pm.expect(d.githubIssue.title).to.eql('Example title'); pm.expect(d.githubIssue.state).to.eql('open'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Linked task\",\n  \"githubIssue\": {\n    \"url\": \"https://www.github.com/24Chessman/TaskBoard/pull/1/?tab=files#top\",\n    \"title\": \"Example title\",\n    \"state\": \"open\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Create a task with javascript:alert(1) - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error names githubIssue', () => pm.expect(pm.response.json().errors[0].field).to.eql('githubIssue'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad link\",\n  \"githubIssue\": {\n    \"url\": \"javascript:alert(1)\"\n  }\n}"
            },
            "url": {
