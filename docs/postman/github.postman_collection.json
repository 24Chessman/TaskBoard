{
  "info": {
    "name": "TaskBoard GitHub",
    "description": "M4.5a GitHub issue lookup (GET /api/github/issue?url=) and the githubIssue safety rule on tasks. Run the requests in order: Setup registers a user and creates a project.\n\nNote: the first lookup request calls the real GitHub API from the server, so it needs internet access and can hit GitHub's rate limit (60 requests per hour without a GITHUB_TOKEN). It accepts 200, 429 or 502 so an offline run does not fail; every other request is answered by TaskBoard itself.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register a user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GitHub Tester\",\n  \"email\": \"github-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Create a project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('projectId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GitHub project {{runId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Lookup",
      "item": [
        {
          "name": "Valid public pull request (needs internet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (found), 429 (GitHub rate limit) or 502 (no internet)', () => pm.expect(pm.response.code).to.be.oneOf([200, 429, 502]));",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  pm.test('returns the canonical url, a title and a state', () => { pm.expect(d.url).to.eql('https://github.com/24Chessman/TaskBoard/pull/1'); pm.expect(d.title).to.be.a('string').and.not.empty; pm.expect(d.state).to.be.oneOf(['open', 'closed']); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/github/issue?url=https://github.com/24Chessman/TaskBoard/pull/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "github",
                "issue"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "https://github.com/24Chessman/TaskBoard/pull/1"
                }
              ]
            }
          }
        },
        {
          "name": "Not a GitHub issue link - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
