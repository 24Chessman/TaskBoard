                  "pm.test('error names the url field', () => pm.expect(pm.response.json().errors[0].field).to.eql('url'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
