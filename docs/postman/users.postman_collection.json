{
  "info": {
    "name": "TaskBoard Users",
    "description": "M3.5 users endpoints. Run the folders in order: Setup registers users A and B, then the normal-user requests and the 403 checks use their tokens.\n\nThe last folder, 'Admin (optional)', needs a real admin account. Fill adminEmail and adminPassword in your LOCAL Postman environment or collection variables only (create the admin with `npm run seed:admin` in server/). Never commit real values: they must stay empty in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "password", "value": "secret123" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "tokenA", "value": "" },
    { "key": "tokenB", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "userAId", "value": "" },
    { "key": "userBId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register user A",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('runId', String(Date.now()));"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenA', body.data.token);",
                  "pm.collectionVariables.set('userAId', body.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Alpha {{runId}}\",\n  \"email\": \"users-a-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register user B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenB', body.data.token);",
                  "pm.collectionVariables.set('userBId', body.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Bravo {{runId}}\",\n  \"email\": \"users-b-{{runId}}@example.com\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "Normal user",
      "item": [
        {
          "name": "Search users by name (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('finds both users, paginated, only public fields', () => {",
                  "  pm.expect(body.total).to.eql(2);",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.limit).to.eql(10);",
                  "  pm.expect(Object.keys(body.data[0]).sort()).to.eql(['_id', 'email', 'name']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?search={{runId}}&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "search", "value": "{{runId}}" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search users by email (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only user B matches', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.total).to.eql(1);",
                  "  pm.expect(body.data[0]._id).to.eql(pm.collectionVariables.get('userBId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?search=users-b-{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "search", "value": "users-b-{{runId}}" }]
            }
          }
        },
        {
          "name": "Get one user (A reads B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no password or role is exposed', () => {",
                  "  const user = pm.response.json().data;",
                  "  pm.expect(user).to.not.have.property('password');",
                  "  pm.expect(user).to.not.have.property('role');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}"] }
          }
        },
        {
          "name": "Update own profile (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('name changed, role unchanged, no password', () => {",
                  "  const user = pm.response.json().data;",
                  "  pm.expect(user.name).to.eql('Users Alpha Renamed');",
                  "  pm.expect(user.role).to.eql('user');",
                  "  pm.expect(user).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Alpha Renamed\",\n  \"email\": \"users-a-{{runId}}@example.com\",\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        }
      ]
    },
    {
      "name": "Failure cases",
      "item": [
        {
          "name": "Search - no token",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users?search=users", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "search", "value": "users" }] }
          }
        },
        {
          "name": "Search - one character (A)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users?search=u", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "search", "value": "u" }] }
          }
        },
        {
          "name": "Search - no search term (A)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get one user - invalid id",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users/not-an-id", "host": ["{{baseUrl}}"], "path": ["users", "not-an-id"] }
          }
        },
        {
          "name": "Get one user - unknown id",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 404', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users/000000000000000000000001", "host": ["{{baseUrl}}"], "path": ["users", "000000000000000000000001"] }
          }
        },
        {
          "name": "Update another user's profile (A edits B)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hijacked\",\n  \"email\": \"hijack-{{runId}}@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}"] }
          }
        },
        {
          "name": "Update own profile - missing name (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('errors array names the field', () => pm.expect(pm.response.json().errors[0].field).to.eql('name'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"users-a-{{runId}}@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        },
        {
          "name": "Update own profile - duplicate email (A uses B's email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('message is Email already registered', () => pm.expect(pm.response.json().message).to.eql('Email already registered'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Alpha\",\n  \"email\": \"users-b-{{runId}}@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        },
        {
          "name": "Change password - wrong currentPassword (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error names currentPassword', () => pm.expect(pm.response.json().errors[0].field).to.eql('currentPassword'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Alpha\",\n  \"email\": \"users-a-{{runId}}@example.com\",\n  \"password\": \"newsecret1\",\n  \"currentPassword\": \"not-my-password\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        },
        {
          "name": "Change password - missing currentPassword (A)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Users Alpha\",\n  \"email\": \"users-a-{{runId}}@example.com\",\n  \"password\": \"newsecret1\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        },
        {
          "name": "Change role as normal user (A)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}/role", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}", "role"] }
          }
        },
        {
          "name": "Delete user as normal user (A deletes B)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin (optional)",
      "description": "Needs adminEmail and adminPassword filled in locally. Leave them empty in the committed file. Run in order.",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('logged in as admin', () => pm.expect(body.data.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('tokenAdmin', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Admin lists users without a search term",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('admin also sees role and createdAt', () => {",
                  "  const first = pm.response.json().data[0];",
                  "  pm.expect(first).to.have.property('role');",
                  "  pm.expect(first).to.have.property('createdAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": { "raw": "{{baseUrl}}/users?limit=5", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "limit", "value": "5" }] }
          }
        },
        {
          "name": "Admin changes user B's role to admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is admin', () => pm.expect(pm.response.json().data.role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}/role", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}", "role"] }
          }
        },
        {
          "name": "Admin sets an invalid role",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"boss\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}/role", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}", "role"] }
          }
        },
        {
          "name": "Admin deletes user B",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userBId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userBId}}"] }
          }
        },
        {
          "name": "Admin deletes user A",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userAId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userAId}}"] }
          }
        }
      ]
    }
  ]
}
